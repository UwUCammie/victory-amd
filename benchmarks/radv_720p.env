# Source after radv_first_room.env on the Linux/RADV renderer with the
# output-size patch and size-limited compute scheduling.
export VICTORY_OUTPUT=${VICTORY_OUTPUT:-1280x720}
export VICTORY_EARLY_COMPUTE=${VICTORY_EARLY_COMPUTE-1}
export VICTORY_EARLY_COMPUTE_MAX_BYTES=${VICTORY_EARLY_COMPUTE_MAX_BYTES-1024}
