# RX 7900 XT, linux-amd-best, Series X. Source this file before starting VIctory.
# Existing environment settings take precedence.
export VICTORY_AMBIENT=${VICTORY_AMBIENT-0.8}
export VICTORY_AMD_PICKS=${VICTORY_AMD_PICKS-1}
export VICTORY_BVH_BUILDER=${VICTORY_BVH_BUILDER-0}
export VICTORY_BVH_QUARANTINE=${VICTORY_BVH_QUARANTINE-1}
export VICTORY_CARD_AWAKE=${VICTORY_CARD_AWAKE-1}
export VICTORY_CARD_BUFFERS_MB=${VICTORY_CARD_BUFFERS_MB-4096}
export VICTORY_CARD_BUFFERS_MIN_KB=${VICTORY_CARD_BUFFERS_MIN_KB-256}
export VICTORY_CARD_REHASH_RUNS=${VICTORY_CARD_REHASH_RUNS-1}
export VICTORY_CARD_STEPS=${VICTORY_CARD_STEPS-2}
export VICTORY_COMPUTE_WAIT=${VICTORY_COMPUTE_WAIT-1}
export VICTORY_HEAP_WORKER=${VICTORY_HEAP_WORKER-1}
export VICTORY_HOLE_SKIP=${VICTORY_HOLE_SKIP-1}
export VICTORY_INDIRECT_BATCH=${VICTORY_INDIRECT_BATCH-2}
export VICTORY_INDIRECT_WINDOW=${VICTORY_INDIRECT_WINDOW-1}
export VICTORY_JOIN_COPIES=${VICTORY_JOIN_COPIES-1}
export VICTORY_JOIN_PARTS=${VICTORY_JOIN_PARTS-8}
export VICTORY_MAP_THREADS=${VICTORY_MAP_THREADS-1}
export VICTORY_MATERIAL_DEMAND=${VICTORY_MATERIAL_DEMAND-1}
export VICTORY_PIPE_FIX=${VICTORY_PIPE_FIX-1}
export VICTORY_RELAY=${VICTORY_RELAY-2}
export VICTORY_RELAY_COPY=${VICTORY_RELAY_COPY-1}
export VICTORY_SHOW_AFTER=${VICTORY_SHOW_AFTER-1}
export VICTORY_SKIP_PIPELINES=${VICTORY_SKIP_PIPELINES-none}
export VICTORY_SUBMIT_DEPTH=${VICTORY_SUBMIT_DEPTH-128}
export VICTORY_SUBMIT_FRAMES=${VICTORY_SUBMIT_FRAMES-2}
export VICTORY_TEXTURE_NO_WAIT=${VICTORY_TEXTURE_NO_WAIT-1}
export VICTORY_THIN=${VICTORY_THIN-1}
export VICTORY_TITLE_PRIORITIES=${VICTORY_TITLE_PRIORITIES-0}
export VICTORY_UPLOAD_AHEAD=${VICTORY_UPLOAD_AHEAD-1}
export VICTORY_WIDE_BACK=${VICTORY_WIDE_BACK-1}
